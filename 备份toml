[project]
name = "knowledge-base"
version = "0.1.0"
description = "Add your description here"
requires-python = ">=3.11"
dependencies = [
    "colorlog>=6.12.0",
    "django-knowledge>=0.2.0",
    "fastapi>=0.141.1",
    "grandalf>=0.8",
    "langchain>=1.3.15",
    "langchain-openai>=1.4.3",
    "langchain-text-splitters>=1.1.2",
    "langgraph>=1.2.11",
    "minio>=7.2.20",
    "numpy>=2.4.6",
    "popen>=0.1.20",
    "pymilvus>=3.0.1",
    "pymongo>=4.17.0",
    "python-dotenv>=1.2.2",
]

[project.scripts]
knowledge-base = "knowledge_base:main"

[build-system]
requires = ["uv_build>=0.12.1,<0.13.0"]
build-backend = "uv_build"
